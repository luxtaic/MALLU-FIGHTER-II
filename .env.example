# MALLU FIGHTER II — Dedicated Malayalam (ml-IN) Cloud TTS Configuration
# Copy this file to `.env` (in `kerala_fighter/.env` or `~/.env`) and fill in your key.
# NEVER commit `.env` with real keys to source control.

# Preferred provider: azure | google | gnani
TTS_PROVIDER=azure

# Gender / voice override: auto (matches male/female character), male, female
TTS_GENDER_MODE=auto
# Optional exact voice ID override (e.g. ml-IN-MidhunNeural, ml-IN-SobhanaNeural, ml-IN-Chirp3-HD-Achird, ml-IN-Wavenet-A)
TTS_VOICE_OVERRIDE=auto

# --- Option 1 (Recommended): Microsoft Azure AI Speech (ml-IN-MidhunNeural & ml-IN-SobhanaNeural) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia

# --- Option 2: Google Cloud Text-to-Speech (ml-IN-Chirp3-HD-* & ml-IN-Wavenet-A/B/C/D) ---
GOOGLE_CLOUD_TTS_API_KEY=

# --- Option 3: Gnani.ai Vachana TTS (ml-IN, timbre-v3.0) ---
GNANI_API_KEY=
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE_MALE=male
GNANI_TTS_VOICE_FEMALE=female
